#include <iostream.h>
#include <conio.h>

#define MAX 5

class MStack
{
    int a[MAX];
    int b[MAX];
    int top1, top2;

public:

    MStack()
    {
        top1 = -1;
        top2 = -1;
    }

    void push1()
    {
        int x;
        if(top1 == MAX-1)
            cout << "Stack overflow";
        else
        {
            cout << "Enter value: ";
            cin >> x;
            top1++;
            a[top1] = x;
        }
    }

    void push2()
    {
        int x;
        if(top2 == MAX-1)
            cout << "Stack overflow";
        else
        {
            cout << "Enter value: ";
            cin >> x;
            top2++;
            b[top2] = x;
        }
    }

    void pop1()
    {
        if(top1 == -1)
            cout << "Stack underflow";
        else
        {
            cout << "Removed: " << a[top1];
            top1--;
        }
    }

    void pop2()
    {
        if(top2 == -1)
            cout << "Stack underflow";
        else
        {
            cout << "Removed: " << b[top2];
            top2--;
        }
    }

    void show1()
    {
        if(top1 == -1)
            cout << "Stack 1 is empty";
        else
        {
            for(int i = top1; i >= 0; i--)
                cout << a[i] << " ";
        }
    }

    void show2()
    {
        if(top2 == -1)
            cout << "Stack 2 is empty";
        else
        {
            for(int i = top2; i >= 0; i--)
                cout << b[i] << " ";
        }
    }
};

void main()
{
    MStack m;
    int choice;

    cout << "\n1. Push 1";
    cout << "\n2. Push 2";
    cout << "\n3. Pop 1";
    cout << "\n4. Pop 2";
    cout << "\n5. Show 1";
    cout << "\n6. Show 2";

    cout << "\nEnter your choice: ";
    cin >> choice;

    switch(choice)
    {
        case 1: m.push1(); break;
        case 2: m.push2(); break;
        case 3: m.pop1(); break;
        case 4: m.pop2(); break;
        case 5: m.show1(); break;
        case 6: m.show2(); break;
    }

    getch();
}
